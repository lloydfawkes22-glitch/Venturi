 /// wgpu refuses a device asking for more than the adapter offers, and the
 /// defaults exceed small GPUs (Raspberry Pi 4: 4 color attachments, 4096
 /// textures on GL).
+/// Metal's compiler on old Intel Macs (Big Sur) aborts on wgpu's indirect-call
+/// validation shaders and the device is lost. Venturi issues no indirect calls;
+/// WGPU_VALIDATION_INDIRECT_CALL=1 still turns it back on.
+pub fn instance_flags(flags: wgpu::InstanceFlags) -> wgpu::InstanceFlags {
+    if cfg!(all(target_os = "macos", target_arch = "x86_64")) {
+        flags
+            .difference(wgpu::InstanceFlags::VALIDATION_INDIRECT_CALL)
+            .with_env()
+    } else {
+        flags
+    }
+}
+
+/// Whether `device` can build compute pipelines: Metal on old Intel Macs
+/// (Big Sur) fails to compile any of them. Probed once.
+pub fn compute_supported(device: &wgpu::Device) -> bool {
+    static SUPPORTED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *SUPPORTED.get_or_init(|| {
+        let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+            label: Some("vv-render compute probe"),
+            source: wgpu::ShaderSource::Wgsl(
+                "@group(0) @binding(0) var<storage, read_write> out: array<u32>;
+                @compute @workgroup_size(64)
+                fn main(@builtin(global_invocation_id) id: vec3<u32>) {
+                    if id.x < arrayLength(&out) { out[id.x] = id.x; }
+                }"
+                .into(),
+            ),
+        });
+        try_compute_pipeline(
+            device,
+            &wgpu::ComputePipelineDescriptor {
+                label: Some("vv-render compute probe"),
+                layout: None,
+                module: &module,
+                entry_point: Some("main"),
+                compilation_options: Default::default(),
+                cache: None,
+            },
+        )
+        .is_some()
+    })
+}
+
+/// `create_compute_pipeline`, but a pipeline the driver cannot compile is
+/// `None` instead of a fatal wgpu error.
+fn try_compute_pipeline(
+    device: &wgpu::Device,
+    desc: &wgpu::ComputePipelineDescriptor,
+) -> Option<wgpu::ComputePipeline> {
+    let validation = device.push_error_scope(wgpu::ErrorFilter::Validation);
+    let internal = device.push_error_scope(wgpu::ErrorFilter::Internal);
+    let pipeline = device.create_compute_pipeline(desc);
+    let internal = pollster::block_on(internal.pop());
+    let validation = pollster::block_on(validation.pop());
+    match internal.or(validation) {
+        None => Some(pipeline),
+        Some(error) => {
+            eprintln!(
+                "vv-render: {:?} unavailable, using the CPU instead: {error}",
+                desc.label.unwrap_or("compute pipeline")
+            );
+            None
+        }
+    }
+}
+
+/// CPU version of rgba_to_i420.wgsl (without the dither), for GPUs without
+/// compute shaders.
+fn rgba_to_i420(rgba: &[u8], width: u32, height: u32) -> Vec<u8> {
+    let (w, h) = (width as usize, height as usize);
+    let (cw, ch) = (w.div_ceil(2), h.div_ceil(2));
+    let pixel = |x: usize, y: usize| {
+        let i = (y.min(h - 1) * w + x.min(w - 1)) * 4;
+        [rgba[i], rgba[i + 1], rgba[i + 2]].map(|c| f32::from(c) / 255.0)
+    };
+    let luma = |c: [f32; 3]| 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
+    let byte = |v: f32| v.round().clamp(0.0, 255.0) as u8;
+    let mut out = Vec::with_capacity(w * h + 2 * cw * ch);
+    for y in 0..h {
+        for x in 0..w {
+            out.push(byte(16.0 + 219.0 * luma(pixel(x, y))));
+        }
+    }
+    let mut v_plane = Vec::with_capacity(cw * ch);
+    for y in 0..ch {
+        for x in 0..cw {
+            let mut c = [0.0f32; 3];
+            for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                let p = pixel(2 * x + dx, 2 * y + dy);
+                for k in 0..3 {
+                    c[k] += p[k] * 0.25;
+                }
+            }
+            let l = luma(c);
+            out.push(byte(128.0 + 224.0 * (c[2] - l) / 1.8556));
+            v_plane.push(byte(128.0 + 224.0 * (c[0] - l) / 1.5748));
+        }
+    }
+    out.extend(v_plane);
+    out
+}
